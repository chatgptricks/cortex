SENTIENT_DATA_DIR=./data
SENTIENT_ALLOWED_ORIGINS=
DATABASE_URL=
POSTGRES_MIGRATION_URL=
APIFY_TOKEN=
TRICKS_DASH_REFRESH_PASSWORD=
ALLOWED_EMAILS=
ADMIN_EMAILS=

# Only the dedicated worker should run the scheduler and account import queue.
SENTIENT_SCHEDULER_ENABLED=true
SENTIENT_WEB_RUN_SCHEDULER=false
SENTIENT_WEB_RUN_STARTUP_MAINTENANCE=false

# Cloudflare R2 is the only runtime media store.
R2_MEDIA_ENABLED=true
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Optional standalone cover OCR worker.
SENTIENT_OCR_URL=
SENTIENT_OCR_TOKEN=
SENTIENT_OCR_TIMEOUT=300
SENTIENT_OCR_CPU=2
SENTIENT_OCR_MEMORY_MB=2048
SENTIENT_OCR_SCALEDOWN_WINDOW=60
SENTIENT_OCR_MAX_CONTAINERS=3
SENTIENT_OCR_MIN_CONFIDENCE=0.35

# Optional Slack integration.
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
